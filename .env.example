# Email tujuan tetap diarahkan ke hello@abdulrafi.my.id.
CONTACT_EMAIL_TO=hello@abdulrafi.my.id

# Alamat pengirim harus diizinkan oleh penyedia SMTP.
CONTACT_EMAIL_FROM="Abdul Rafi Website <no-reply@abdulrafi.my.id>"
CONTACT_SMTP_HOST=smtp.example.com
CONTACT_SMTP_PORT=587
CONTACT_SMTP_SECURE=false
CONTACT_SMTP_USER=
CONTACT_SMTP_PASSWORD=

# Opsional. Gunakan format internasional, misalnya 628xxxxxxxxxx.
# Variabel ini bersifat public dan dibaca saat aplikasi di-build.
NEXT_PUBLIC_WHATSAPP_NUMBER=
